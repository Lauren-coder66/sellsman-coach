{
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

http://{$PUBLIC_DOMAIN} {
	redir https://{$PUBLIC_DOMAIN}{uri} 308
}

{$PUBLIC_DOMAIN} {
	@voice path /api/sessions/*/voice
	request_body @voice {
		max_size 500KB
	}
	@other not path /api/sessions/*/voice
	request_body @other {
		max_size 64KB
	}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy app:3000
}

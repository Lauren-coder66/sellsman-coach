        {
          "role": "customer",
          "content": "多少钱？"
        },
        {
          "role": "user",
          "content": "要先确认范围。"
        },
        {
          "role": "customer",
          "content": "那稍后再聊。"
        },
        {
          "role": "user",
          "content": "好。"
        }
      ]
